# cluster.conf — 2-node cluster configuration for scalability sweep (Fig 13).
# Copy this file to cluster.conf and fill in your own node addresses:
#   cp cluster.conf.example cluster.conf
#
# Required for: bash scripts/run_scalability.sh
# Not required for any other RQ script (all single-node).

MASTER_IP=<MASTER_NODE_IP>
GLOBAL_CONTROLLER_PORT=8500
MIN_NODES=2
MAX_NODES=2

# Node list: NODE_ID:HOST:GPU_DEVICE:MAX_WORKERS
#   HOST = "local" for the master node, or user@ip for a remote node
#   Remote nodes are reached over SSH (only port 22/SSH needs to be open)
#   MAX_WORKERS depends on GPU memory: ~630MB/worker + ~16GB/GPU for the aggregator
NODES=(
  "node-master:local:cuda:0:<MAX_WORKERS>"
  "node-remote:<USER>@<REMOTE_NODE_IP>:cuda:0:<MAX_WORKERS>"
)

# SSH port overrides for remote nodes, only needed if not using the default port 22
declare -A SSH_PORTS
# SSH_PORTS[<USER>@<REMOTE_NODE_IP>]=<PORT>

# Project root on the remote node (must have the same repo checked out)
REMOTE_PROJECT_ROOT=<REMOTE_PROJECT_ROOT>

# Nodes that use single-aggregator mode (all workers share GPU 0's aggregator).
# Leave empty if every node has one aggregator per GPU.
SINGLE_AGG_NODES=""

# Base ports used by node agent sub-processes (defaults are usually fine)
NODE_AGENT_PORT=9100
CONTROLLER_PORT=8343
AGGREGATOR_HEALTH_PORT=8000

# SSH tunnel config for remote nodes — remote node agents are mapped to
# localhost:{TUNNEL_BASE_PORT}, {TUNNEL_BASE_PORT+1}, ... on the master
TUNNEL_BASE_PORT=9101

# Project path on the master node (this repo's checkout)
PROJECT_ROOT=<MASTER_PROJECT_ROOT>

# Scheduler algorithm
SCHEDULER=${SCHEDULER:-lorant}

# Worker scale-down delay (seconds idle before reaping)
SCALE_DOWN_DELAY=${SCALE_DOWN_DELAY:-300}

# Default adapter for test/stress commands (pool-10 is always generated by setup.sh)
DEFAULT_ADAPTER=../sim-adapters/pool-10/lora-0

# Prewarm GPU distribution per node: NODE_ID:DEVICE1:COUNT1:DEVICE2:COUNT2:...
PREWARM_DEVICES=(
  "node-master:cuda:0:<PREWARM_COUNT>"
  "node-remote:cuda:0:<PREWARM_COUNT>"
)
